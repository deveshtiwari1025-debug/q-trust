diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 2c85a12..1382928 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -53,6 +53,20 @@ jobs:
         with:
           subject-path: 'dist/*'
 
+      - uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2
+
+      - name: Sign every release artifact with cosign (keyless)
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          for artifact in dist/*.whl dist/*.tar.gz; do
+            cosign sign-blob --yes \
+              --output-signature "${artifact}.sig" \
+              --output-certificate "${artifact}.pem" \
+              "${artifact}"
+            echo "Signed ${artifact}"
+          done
+
       - name: Extract changelog section for this tag
         id: notes
         env:
diff --git a/.github/workflows/security.yml b/.github/workflows/security.yml
index 4c68bdd..25d785b 100644
--- a/.github/workflows/security.yml
+++ b/.github/workflows/security.yml
@@ -135,6 +135,36 @@ jobs:
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 
+  npm-audit:
+    name: Node Dependency Audit (${{ matrix.dir }})
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - dir: backend
+            flags: ""
+          - dir: frontend
+            flags: "--omit=dev"
+          - dir: docs-v2
+            flags: "--omit=dev"
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v4.11.0
+        with:
+          node-version: "20"
+
+      - name: Audit shipped dependency tree
+        # Runs daily on a schedule, so an advisory published against an idle
+        # main branch is caught without waiting for the next push.
+        working-directory: ${{ matrix.dir }}
+        run: npm audit --package-lock-only --audit-level=high ${{ matrix.flags }}
+
+      - name: Report dev-only advisories (non-blocking)
+        if: matrix.flags != ''
+        working-directory: ${{ matrix.dir }}
+        run: npm audit --package-lock-only --audit-level=high || true
+
   dev-key-guard:
     name: Reject Known Dev Keys Outside Tests
     runs-on: ubuntu-latest
